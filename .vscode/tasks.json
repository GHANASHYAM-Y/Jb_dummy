{
  // EVOAIQU — start the app inside VS Code's own terminal.
  // Run with: Ctrl+Shift+P → "Tasks: Run Task" → "Start servers (dev + prod)".
  // Both servers open side by side in the Terminal panel. Stop one with the
  // trash icon on its terminal, or Ctrl+C inside it.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev server (3000)",
      "type": "npm",
      "script": "dev",
      "path": "data",
      "isBackground": true,
      "presentation": { "group": "evoaiqu-servers", "panel": "dedicated", "reveal": "always", "clear": true },
      "problemMatcher": {
        "owner": "evoaiqu-dev",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "activesBegins": true, "beginsPattern": "Next\\.js", "endsPattern": "Ready in|ready in" }
      }
    },
    {
      "label": "Prod server (3001)",
      "detail": "Builds first (a couple of minutes), then serves on port 3001",
      "type": "npm",
      "script": "prod",
      "path": "data",
      "isBackground": true,
      "presentation": { "group": "evoaiqu-servers", "panel": "dedicated", "reveal": "always", "clear": true },
      "problemMatcher": {
        "owner": "evoaiqu-prod",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "activesBegins": true, "beginsPattern": "Next\\.js", "endsPattern": "Ready in|ready in" }
      }
    },
    {
      "label": "Start servers (dev + prod)",
      "dependsOn": ["Dev server (3000)", "Prod server (3001)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
