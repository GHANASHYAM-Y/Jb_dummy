# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/data/node_modules
/data/.pnp
/data/.pnp.*
data/.yarn/*
!data/.yarn/patches
!data/.yarn/plugins
!data/.yarn/releases
!data/.yarn/versions

# Testing & Coverage
/data/coverage

# Next.js build & export outputs
/data/.next/
/data/out/
/data/build
/data/dist

# Diagnostic & Temporary Workspace Folders
/scratch/
/data/.tempmediaStorage/
data/supabase/.temp/
/.worktree-*/
/.worktree-security/

# Operating System & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly allow safe environment templates
!.env.example

# Vercel
.vercel

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts

# Credentials, Certificates & Keys
*.pem
*.key
*.cert
*.crt
credentials.json
