# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js build & export outputs
/.next/
/out/
/build
/dist

# Diagnostic & Temporary Workspace Folders
/scratch/
/.tempmediaStorage/
supabase/.temp/

# Operating System & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Explicitly allow safe environment templates
!.env.example

# Vercel
.vercel

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts

# Credentials, Certificates & Keys
*.pem
*.key
*.cert
*.crt
credentials.json
